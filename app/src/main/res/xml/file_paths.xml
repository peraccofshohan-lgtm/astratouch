<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider allowlist.

  Only these directories can ever be turned into a shareable content:// URI via
  FileProvider.getUriForFile(). Anything outside them throws, which is what keeps
  a granted URI from becoming a read primitive over app-private data.

  Keep this list in sync with the code that writes files:
   * files/captures   -> ScreenshotStore (screenshots, cropped/annotated edits)
   * files/recordings -> ScreenCaptureService (MediaProjection MP4s)
   * cache/shared     -> transient exports handed to a chooser
   * files/shared     -> long-lived exports handed to a chooser
-->
<paths>
    <files-path name="captures" path="captures/" />
    <files-path name="recordings" path="recordings/" />
    <files-path name="shared" path="shared/" />
    <cache-path name="shared_cache" path="shared/" />
    <cache-path name="screenshots" path="screenshots/" />
</paths>
