    <!-- Permission copy -->
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_purpose">Required for the floating bubble and the radial menu, which must be drawn on top of other apps.</string>
    <string name="perm_accessibility_title">Accessibility service</string>
    <string name="perm_accessibility_purpose">Required for global Home / Back / Recents, notification shade, Quick Settings, and screenshot capture.</string>
    <string name="perm_writesettings_title">Modify system settings</string>
    <string name="perm_writesettings_purpose">Required for brightness and auto-rotation actions. Optional.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_purpose">Required for the persistent "AstraTouch is active" status and macro/timer alerts.</string>
    <string name="perm_camera_title">Camera (flashlight)</string>
    <string name="perm_camera_purpose">Required only for the flashlight action. Never used to take pictures.</string>
    <string name="perm_battery_title">Ignore battery optimisation</string>
    <string name="perm_battery_purpose">Optional. Helps the bubble survive aggressive OEM background restrictions.</string>

