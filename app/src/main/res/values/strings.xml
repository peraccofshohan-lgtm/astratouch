    <!-- Accessibility -->
    <string name="accessibility_service_label">AstraTouch Actions</string>
    <string name="accessibility_service_summary">Enables global navigation, quick settings and screenshot actions from the AstraTouch menu.</string>
    <string name="accessibility_service_description">AstraTouch uses this accessibility service to perform global actions you explicitly trigger from the floating bubble: Home, Back, Recents, Notifications, Quick Settings and screen capture. It reads only window-change events to know when the current app changes. AstraTouch never reads, stores or transmits the text on your screen, and it never acts without your input. You can turn it off at any time in Android Settings.</string>

    <string name="device_admin_label">AstraTouch screen lock</string>
    <string name="device_admin_description">Lets AstraTouch lock the screen from the floating menu. Only the force-lock policy is used.</string>

    <!-- Overlay / notifications -->
    <string name="overlay_channel_name">Floating controls</string>
    <string name="overlay_channel_description">Keeps the AstraTouch bubble available while you use other apps.</string>
    <string name="overlay_notification_title">AstraTouch is active</string>
    <string name="overlay_notification_text">Tap to open the control center. Use Hide to remove the bubble.</string>
    <string name="overlay_notification_hide">Hide bubble</string>
    <string name="overlay_notification_stop">Stop</string>
    <string name="capture_channel_name">Screen capture</string>
    <string name="capture_channel_description">Shows that AstraTouch is recording or capturing your screen.</string>
    <string name="capture_notification_title">AstraTouch screen capture</string>
    <string name="capture_notification_text">Screen recording is running. Tap Stop to finish.</string>
    <string name="capture_notification_stop">Stop recording</string>

